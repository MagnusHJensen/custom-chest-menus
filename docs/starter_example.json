{
  "$schema": "https://raw.githubusercontent.com/MagnusHJensen/custom-chest-menus/refs/heads/1.21.1/docs/v2.schema.json",
  "format_version": 2,
  "id": "test_menu",
  "name": "Test Menu",
  "size": "single",
  "background": {
    "texture": "ccm_pack:textures/ccm_single_with_inv_176_168.png", // This is a path to a texture in a resource pack
    "size": {
      "width": 176,
      "height": 168
    },
    "show_player_inventory": true,
    "title_location": {
      "x": 7,
      "y": 7
    }
  },
  "pages": [
    {
      "title": "First page",
      "items": [
        {
          "name": "Close menu",
          "slot": 8,
          "item": "minecraft:barrier",
          "count": 64,
          "action": {
            "type": "close"
          },
          "components": {
            "minecraft:lore": [
              "{\"text\": \"My awesome LORE\",\"color\": \"aqua\",\"bold\": true}"
            ]
          }
        },
        {
          "name": "Test",
          "slot": 10,
          "item": "minecraft:player_head",
          "count": 1,
          "components": {
            "minecraft:profile": "legendenv2"
          }
        },
        {
          "name": "Drop party!",
          "slot": 13,
          "item": "minecraft:diamond",
          "action": {
            "type": "command",
            "commands": ["give %player% minecraft:diamond 10", "say Enjoy your diamonds, %player%!"],
            "run_as_player": true
          },
          "close_on_click": true,
          "components": {
            "minecraft:enchantment_glint_override": true
          }
        },
        {
          "name": "Last page",
          "slot": 24,
          "item": "minecrat:arrow",
          "action": {
            "type": "jump_to_page",
            "target_page_index": 500
          }
        },
        {
          "name": "Previous page",
          "slot": 25,
          "item": "minecraft:stone",
          "action": {
            "type": "previous_page"
          }
        },
        {
          "name": "Next page",
          "slot": 26,
          "item": "minecraft:grass_block",
          "action": {
            "type": "next_page"
          }
        }
      ]
    },
    {
      "title": "Second page",
      "items": [
        {
          "name": "Close menu",
          "slot": 0,
          "item": "minecraft:barrier",
          "action": {
            "type": "close"
          }
        },
        {
          "name": "Teleport to spawn",
          "action": {
            "type": "teleport",
            "x": 10,
            "y": 10,
            "z": 10,
            "dimension": "minecraft:overworld"
          },
          "item": "minecraft:ender_pearl",
          "slot": 13
        },
        {
          "name": "Teleport to nether",
          "action": {
            "type": "teleport",
            "x": 10,
            "y": 10,
            "z": 10,
            "dimension": "minecraft:the_nether"
          },
          "item": "minecraft:blaze_rod",
          "slot": 14
        },
        {
          "name": "Craft Grass block 2",
          "slot": 20,
          "item": "minecraft:crafting_table",
          "action": {
            "type": "craft_items",
            "inputs": [
              {
                "item": "minecraft:diamond",
                "count": 5
              }
            ],
            "outputs": [
              {
                "item": "minecraft:grass_block",
                "components": {
                  "minecraft:lore": [
                    "{\"text\": \"Crafted with diamonds!\",\"color\": \"green\"}"
                  ],
                  "minecraft:enchantment_glint_override": true
                }
              }
            ],
            "missing_input_message": [{"text": "You are missing %missing%x %item%, you need %required% and have %available%.", "color": "gold", "bold": true}]
          }
        },
        {
          "name": "Previous page",
          "slot": 25,
          "item": "minecraft:stone",
          "action": {
            "type": "previous_page"
          }
        },
        {
          "name": "Next page",
          "slot": 26,
          "item": "minecraft:grass_block",
          "action": {
            "type": "next_page"
          }
        }
      ]
    },
    {
      "title": "Third page",
      "items": [
        {
          "name": "Close menu",
          "slot": 0,
          "item": "minecraft:barrier",
          "action": {
            "type": "close"
          }
        },
        {
          "name": "Previous page",
          "slot": 25,
          "item": "minecraft:stone",
          "action": {
            "type": "previous_page"
          }
        },
        {
          "name": "Next page",
          "slot": 26,
          "item": "minecraft:grass_block",
          "action": {
            "type": "next_page"
          }
        }
      ]
    }
  ]
}