{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Custom Chest Menu Definition (v1)",
  "type": "object",
  "required": ["format_version", "id", "name", "size", "pages"],
  "properties": {
    "format_version": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_\\-]+$"
    },
    "name": {
      "type": "string"
    },
    "size": {
      "type": "string",
      "enum": ["single", "double"],
      "description": "Determines chest size: single (3 rows) or double (6 rows)"
    },
    "filler": {
      "type": "object",
      "required": ["item"],
      "properties": {
        "item": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "lore": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "items"],
        "properties": {
          "title": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["slot", "item", "name", "action"],
              "properties": {
                "slot": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 53
                },
                "item": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "count": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 64,
                  "default": 1
                },
                "lore": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "action": {
                  "type": "object",
                  "oneOf": [
                    {
                      "properties": {
                        "type": { "const": "close" }
                      },
                      "required": ["type"],
                      "additionalProperties": false
                    },
                    {
                      "properties": {
                        "type": { "const": "teleport" },
                        "x": { "type": "number" },
                        "y": { "type": "number" },
                        "z": { "type": "number" },
                        "dimension": { "type": "string" }
                      },
                      "required": ["type", "x", "y", "z"],
                      "additionalProperties": false
                    },
                    {
                      "properties": {
                        "type": { "const": "next_page" }
                      },
                      "required": ["type"],
                      "additionalProperties": false
                    },
                    {
                      "properties": {
                        "type": { "const": "previous_page" }
                      },
                      "required": ["type"],
                      "additionalProperties": false
                    },
                    {
                      "properties": {
                        "type": { "const":  "jump_to_page" },
                        "target_page_index": { "type": "integer", "minimum": 0 }
                      },
                      "required": ["type", "target_page_index"],
                      "additionalProperties": false
                    },
                    {
                      "properties": {
                        "type": { "const": "command" },
                        "command": {
                          "type": "string",
                          "description": "The full command to run when clicked. Supports placeholders, see GitHub README for more info."
                        },
                        "commands": {
                          "type": "array",
                          "minItems": 1,
                          "items": {
                            "type": "string"
                          },
                          "description": "A list of commands to run when clicked. Supports placeholders, see GitHub README for more info."
                        },
                        "run_as_player": { "type": "boolean",
                          "default": false,
                          "description": "Determines whether or not the player will execute the command, or the server. BE AWARE of running server commands that users can run."
                        }
                      },
                      "required": ["type"],
                      "oneOf": [
                        {
                          "required": ["commands"]
                        },
                        {
                          "required": ["command"]
                        }
                      ],
                      "additionalProperties": false
                    },
                    {
                      "properties": {
                        "type": { "const": "craft_items" },
                        "inputs": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "item": { "type": "string" },
                              "quantity": {
                                "type": "integer",
                                "minimum": 1,
                                "default": 1
                              }
                            }
                          },
                          "minItems": 1
                        },
                        "outputs": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "item": { "type": "string" },
                              "quantity": {
                                "type": "integer",
                                "minimum": 1,
                                "default": 1
                              }
                            }
                          },
                          "minItems": 1
                        }
                      },
                      "required": ["type", "inputs", "outputs"],
                      "additionalProperties": false
                    }
                  ]
                },
                "nbt": {
                  "type": "object",
                  "description": "An object representing the NBT data for the item. Follows the standard Minecraft NBT JSON format."
                }
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
